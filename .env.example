# Voorbeeld voor Docker op een eigen server (docker compose). NIET zo in Render importeren:
# op Render maakt de Blueprint de instellingen aan; vul daar alleen je eigen sleutels in.
# Lege of voorbeeldwaarden worden genegeerd.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_PASSWORD=

# mock = demodata, safecube = Safecube/Sinay, terminal49 = Terminal49, dcsa = per rederij een eigen API
TRACKING_DEFAULT_PROVIDER=mock
SAFECUBE_API_KEY=
TERMINAL49_API_KEY=
# Alleen invullen als het afwijkt van de standaard:
# SAFECUBE_BASE_URL=https://api.sinay.ai/container-tracking/api/v2
# SAFECUBE_API_KEY_HEADER=API_KEY
# API-sleutels per rederij; de naam van de variabele vul je in bij Stamgegevens > Rederijen
# MAERSK_API_KEY=

# E-mail (SMTP): wordt alleen gebruikt als server, gebruiker en wachtwoord alle drie zijn ingevuld.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Publieke adres van het portaal, bijv. https://portaal.jouwbedrijf.nl (op Render automatisch)
PORTAL_BASE_URL=
DAILY_DIGEST_TIME=07:30
TESSERACT_LANG=nld+eng

# Token voor /cron/<token>/ (alleen nodig zonder achtergrondproces)
CRON_TOKEN=
# Eerste beheerder (wordt alleen aangemaakt als hij nog niet bestaat)
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
