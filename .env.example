DJANGO_SECRET_KEY=vervang-door-een-lange-willekeurige-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portaal.example.nl,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portaal.example.nl
POSTGRES_PASSWORD=wijzig-mij
# mock = demodata, terminal49 = alle rederijen via Terminal49, dcsa = per rederij een eigen API
TRACKING_DEFAULT_PROVIDER=terminal49
TESSERACT_LANG=nld+eng
# API-sleutels per rederij; de naam van de variabele vul je in bij Stamgegevens > Rederijen
# MAERSK_API_KEY=...

# --- E-mail (SMTP) ---
# Office 365: smtp.office365.com / 587 / TLS; gebruik bij voorkeur een apart (functioneel) mailadres.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=portaal@example.nl
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OPS/VET Portaal <portaal@example.nl>
# Publieke adres van het portaal (voor links in e-mails en uitnodigingen)
PORTAL_BASE_URL=https://portaal.example.nl
DAILY_DIGEST_TIME=07:30

# --- Tracking: OAuth2 voorbeeld (Maersk) ---
# MAERSK_CLIENT_ID=...
# MAERSK_CLIENT_SECRET=...

# Terminal49 (https://app.terminal49.com > Developers > API keys)
TERMINAL49_API_KEY=
# Token voor /cron/<token>/ (gratis hosting zonder achtergrondproces)
CRON_TOKEN=
# Eerste beheerder (wordt alleen aangemaakt als hij nog niet bestaat)
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=

# Safecube / Sinay container tracking (gratis: 5 zendingen)
SAFECUBE_API_KEY=
# Controleer deze twee in je Safecube-account / documentatie:
SAFECUBE_BASE_URL=https://api.sinay.ai/container-tracking/api/v2
SAFECUBE_API_KEY_HEADER=API_KEY
