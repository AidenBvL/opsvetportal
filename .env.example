DJANGO_SECRET_KEY=vervang-door-een-lange-willekeurige-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portaal.example.nl,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portaal.example.nl
POSTGRES_PASSWORD=wijzig-mij
# mock = demo-data, dcsa = echte DCSA Track & Trace API (per rederij in te stellen)
TRACKING_DEFAULT_PROVIDER=mock
TESSERACT_LANG=nld+eng
# API-sleutels per rederij; de naam van de variabele vul je in bij Stamgegevens > Rederijen
# MAERSK_API_KEY=...

# --- E-mail (SMTP) ---
# Office 365: smtp.office365.com / 587 / TLS; gebruik bij voorkeur een apart (functioneel) mailadres.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=portaal@example.nl
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OPS/VET Portaal <portaal@example.nl>
# Publieke adres van het portaal (voor links in e-mails en uitnodigingen)
PORTAL_BASE_URL=https://portaal.example.nl
DAILY_DIGEST_TIME=07:30

# --- Tracking: OAuth2 voorbeeld (Maersk) ---
# MAERSK_CLIENT_ID=...
# MAERSK_CLIENT_SECRET=...
